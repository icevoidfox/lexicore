# Modified for LexiCore project: removed unused sections for cleaner structure.

### Csharp ###
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# User-specific files
*.user
*.suo
*.sln.docstates
*.userprefs

# .NET / NuGet
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Test Results & Coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# Temporary files & logs
*.log
*.tlog
*.tmp
*.cache

### IDE Specific ###
# Visual Studio / JetBrains Rider / VS Code
.vs/
.idea/
*.DotSettings.user
*.sln.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

### Windows ###
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
